CORS_ALLOWED_ORIGINS=https://your-web-domain.com
API_PUBLIC_PORT=8080
AUTH_ACCESS_TOKEN_SECRET=change-me-access-secret
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-secret
VERIFICATION_INTERNAL_SECRET=change-me-verification-secret
RATING_INTERNAL_SECRET=change-me-rating-secret
CUSTOMIZATION_INTERNAL_SECRET=change-me-customization-secret
ADMIN_API_SECRET=change-me-admin-secret
DEFAULT_RESULT_SOUND_URL=https://cdn.chadchat.example/sounds/default_win.mp3
DEFAULT_QUEUE_TYPE=duel
DEFAULT_REGION=global
STORAGE_BUCKET=chadchat
STORAGE_ENDPOINT=https://ams1.vultrobjects.com
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=https://chadchat.ams1.vultrobjects.com
STORAGE_AVATAR_PREFIX=avatars
STORAGE_ACCESS_KEY=change-me-storage-access-key
STORAGE_SECRET_KEY=change-me-storage-secret-key
MYSQL_DATABASE=chadchat
MYSQL_USER=app
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_DSN=app:change-me-mysql-password@tcp(mysql:3306)/chadchat?parseTime=true&multiStatements=true&charset=utf8mb4

# Optional image overrides for registry-based deploys.
# Example:
# API_GATEWAY_IMAGE=ghcr.io/yourname/chadchat-api-gateway:main
# ADMIN_SERVICE_IMAGE=ghcr.io/yourname/chadchat-admin-service:main
# AUTH_SERVICE_IMAGE=ghcr.io/yourname/chadchat-auth-service:main
# VERIFICATION_SERVICE_IMAGE=ghcr.io/yourname/chadchat-verification-service:main
# TEST_LAB_SERVICE_IMAGE=ghcr.io/yourname/chadchat-test-lab-service:main
# LIVE_CHAT_SERVICE_IMAGE=ghcr.io/yourname/chadchat-live-chat-service:main
# DUEL_SERVICE_IMAGE=ghcr.io/yourname/chadchat-duel-service:main
# ML_SERVICE_IMAGE=ghcr.io/yourname/chadchat-ml-service:main

# Optional overrides when you later move services to separate VPS hosts.
# Example:
# AUTH_SERVICE_URL=http://10.0.0.11:8081
# ML_SERVICE_URL=http://10.0.0.12:8090
