CORS_ALLOWED_ORIGINS=https://your-web-domain.com
API_PUBLIC_PORT=8080
AUTH_ACCESS_TOKEN_SECRET=change-me-access-secret
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-secret

# Optional image overrides for registry-based deploys.
# Example:
# API_GATEWAY_IMAGE=ghcr.io/yourname/omoggle-api-gateway:main
# AUTH_SERVICE_IMAGE=ghcr.io/yourname/omoggle-auth-service:main
# VERIFICATION_SERVICE_IMAGE=ghcr.io/yourname/omoggle-verification-service:main
# TEST_LAB_SERVICE_IMAGE=ghcr.io/yourname/omoggle-test-lab-service:main
# LIVE_CHAT_SERVICE_IMAGE=ghcr.io/yourname/omoggle-live-chat-service:main
# DUEL_SERVICE_IMAGE=ghcr.io/yourname/omoggle-duel-service:main
# ML_SERVICE_IMAGE=ghcr.io/yourname/omoggle-ml-service:main

# Optional overrides when you later move services to separate VPS hosts.
# Example:
# AUTH_SERVICE_URL=http://10.0.0.11:8081
# ML_SERVICE_URL=http://10.0.0.12:8090
